---
import Base from '@/layouts/Base.astro';
import PageAurora from '@/components/PageAurora.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
---

<Base title="Marketing Governance · Fractional CMO · Platform Play Venture" description="We take responsibility for how marketing is planned and executed. As a fractional CMO, we guide direction, align execution with strategy, and ensure every campaign moves the brand toward the same business goal.">
  <ScrollProgress />

  <div class="site-shell is-ready">
    <PageAurora />
    <Nav />

    <main class="service-page">
      <section class="service-hero">
        <div class="service-hero-bg" aria-hidden="true">
          <span class="service-hero-blob a"></span>
          <span class="service-hero-blob b"></span>
        </div>
        <div class="container service-hero-inner">
          <a class="service-hero-back reveal" href="/">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            <span>Back to Home</span>
          </a>
          <div class="service-hero-eyebrow reveal"><span class="pulse-dot"></span><span>Service · 03</span></div>
          <h1 class="service-hero-title reveal">Marketing <span class="grad-text">Governance</span></h1>
          <p class="service-hero-lead reveal">Fractional CMO oversight — guiding direction, aligning execution with strategy, and ensuring every campaign moves the brand toward the same business goal.</p>
        </div>
      </section>

      <section class="section system-section">
        <div class="container system-inner">
          <div class="reveal system-copy">
            <div class="section-kicker">Fractional CMO Approach</div>
            <h2 class="section-title">We take responsibility for <span class="grad-text">how marketing is planned and executed</span>.</h2>
            <p>As a fractional CMO, PPV works with the brand's existing agencies, agencies from our network, or any new agency the brand chooses to onboard. Our role is to guide the direction, align execution with strategy, and ensure every campaign, platform, and activity moves the brand towards the same business goal.</p>
            <p>The role is senior, embedded, and accountable to outcomes — not headcount. We stay involved in decision-making while the brand continues to operate without the overhead of a full-time in-house CMO.</p>
          </div>
        </div>
      </section>

      <section class="section service-placeholder-section">
        <div class="container">
          <div class="service-placeholder reveal">
            <div class="service-placeholder-tag">Detailed page in progress</div>
            <h2>Full Marketing Governance breakdown — coming soon.</h2>
            <p>Workshops, fractional engagement models, agency-alignment workflows, and reporting structures will be detailed here as we publish the full playbook. In the meantime — happy to walk you through the approach directly.</p>
            <div class="service-placeholder-actions">
              <a class="service-cta-btn" href="/#contact">
                <span>Talk to us about a fractional CMO engagement</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a class="service-placeholder-link" href="/services/strategy-consulting">
                <span>Explore Strategy & Consulting</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <script>
    import '@/scripts/site.ts';
  </script>
</Base>
