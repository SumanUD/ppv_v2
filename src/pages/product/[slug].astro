---
import Base from '@/layouts/Base.astro';
import PageAurora from '@/components/PageAurora.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import {
  products,
  hrmsChallenges,
  hrmsCapabilities,
  hrmsLifecycle,
  hrmsCategories,
  hrmsRoles,
  hrmsIntegrations,
  hrmsMigration,
  hrmsPhases,
  hrmsWhy,
  hrmsOnboardingInputs,
  dmsPillars,
  dmsRoles,
  dmsModules,
  dmsMatrix,
  dmsOrderStatus,
  dmsChannels,
  dmsFoundations,
  dmsAiPhases,
  dmsDifferentiators,
} from '@/data/products';
import PageFaq from '@/components/PageFaq.astro';
import { pageFaqs, faqPageSchema } from '@/data/faqs';
import dmsSoftwareSchema from '@/data/seo/software-dms.json';
import hrmsSoftwareSchema from '@/data/seo/software-hrms.json';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const isDms = product.slug === 'dms';
/** On-page form that every "talk to us" CTA on this page opens. */
const formAnchor = isDms ? '#dms-enquiry' : '#walkthrough';

/** Line icons for the six DMS modules, in dmsModules order. */
const moduleIcons = [
  // inventory: stacked boxes
  '<path d="M12 2 3 6.5v5L12 16l9-4.5v-5L12 2z"/><path d="M3 6.5 12 11l9-4.5"/><path d="M12 11v5"/><path d="M3 11.5v5L12 21l9-4.5v-5"/>',
  // order: cart
  '<circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/><path d="M2 3h3l2.6 12.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L22 8H6.2"/>',
  // sales & crm: people
  '<circle cx="9" cy="7" r="4"/><path d="M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/><path d="M22 21v-1a6 6 0 0 0-4-5.7"/>',
  // finance: ledger
  '<rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="12" y2="15"/>',
  // service: shield + check
  '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>',
  // reporting: bar chart
  '<line x1="4" y1="20" x2="20" y2="20"/><rect x="6" y="11" width="3" height="7"/><rect x="11" y="6" width="3" height="12"/><rect x="16" y="13" width="3" height="5"/>',
];
const matrixRoles = dmsMatrix.roles;

/** Approved meta, H1 and definition copy (SEO implementation sheet, Nov 2026). */
const seo = isDms
  ? {
      title: 'Dealer & Distributor Management System (DMS) | PPV DMS',
      description: 'PPV DMS is a real-time dealer and distributor management system with IMEI tracking, POS with EMI, warranty and tiered ledgers. Try the live demo.',
      h1: ['PPV DMS:', 'Dealer and Distributor Management System', 'for Multi-Tier Distribution'],
      sub: 'Not software. A business engine.',
      answer: 'PPV DMS is a dealer and distributor management system that connects suppliers, distributors, dealers and direct dealers on one real-time data core. It manages inventory down to IMEI level, orders, pricing and schemes, point-of-sale with EMI, warranty and RMA, and tiered ledgers, so every sale updates stock, accounts and CRM at once.',
    }
  : {
      title: 'HRMS Software in India: HR & Payroll System | PPV HRMS',
      description: 'PPV HRMS is HR and payroll software for Indian businesses: attendance, leave, payroll, recruitment, performance and self-service in one system. Book a demo.',
      h1: ['PPV HRMS:', 'HRMS Software', 'for HR, Payroll and Workforce Management'],
      sub: 'One platform. Complete workforce management.',
      answer: 'PPV HRMS is a human resource management system that brings employee records, attendance, leave, payroll, recruitment, onboarding, performance, assets and employee self-service into one platform. It replaces spreadsheets and disconnected tools with a single source of HR data, with role-based access for sensitive information.',
    };
const pagePath = `/product/${product.slug}/`;
const faqs = pageFaqs[pagePath] ?? [];
const pageSchema = [isDms ? dmsSoftwareSchema : hrmsSoftwareSchema, ...(faqs.length ? [faqPageSchema(pagePath, faqs)] : [])];

/** DMS vs ERP comparison (3 rows, as specified). */
const dmsVsErp = [
  { name: 'Generic ERP', scope: 'Finance, procurement and operations across the whole company', channel: 'Limited — partners usually sit outside the system', units: 'Quantity-based stock', after: 'Usually an add-on or separate tool' },
  { name: 'Automotive DMS', scope: 'Vehicle sales, service bays and parts for car and two-wheeler dealers', channel: 'Single dealer or dealer group', units: 'VIN-based, built for vehicles', after: 'Vehicle service and parts' },
  { name: 'PPV DMS', scope: 'The distribution channel: supplier → distributor → dealer → customer', channel: 'Every tier on one data core, each seeing only its own data', units: 'IMEI / serial-level tracking for every unit', after: 'Warranty and RMA linked to the same unit record' },
];
const roleLabel = (r: string) => r.replace('-', ' ');
const slotFor = (i: number, n: number) => (i === 0 ? 'active' : i === 1 ? 'next' : i === n - 1 ? 'prev' : 'far');
---

<Base
  title={seo.title}
  description={seo.description}
  schema={pageSchema}
  breadcrumbs={[{ name: 'Products', path: '/products/' }, { name: product.name, path: `/product/${product.slug}/` }]}
>
  <ScrollProgress />

  <div class="site-shell is-ready">
    <PageAurora />
    <Nav />

    <main class="service-page">
      <!-- ============== HERO ============== -->
      <section class="service-hero">
        <div class="service-hero-bg" aria-hidden="true">
          <span class="service-hero-blob a"></span>
          <span class="service-hero-blob b"></span>
        </div>
        <div class="container service-hero-inner">
          <a class="service-hero-back reveal" href="/products/">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            <span>All Products</span>
          </a>
          <div class="service-hero-eyebrow reveal">
            <span class="pulse-dot"></span>
            <span>{product.fullName}{product.status === 'live' ? ' · Live' : ''}</span>
          </div>
          <h1 class="service-hero-title reveal">{seo.h1[0]} <span class="grad-text">{seo.h1[1]}</span> {seo.h1[2]}</h1>
          <p class="service-hero-sub reveal">{seo.sub}</p>
          <p class="service-hero-lead reveal">{product.tagline}</p>

          <div class="pv-hero-metrics reveal">
            {product.metrics.map((m) => (
              <div class="pv-metric">
                <div class="pv-metric-value">{m.value}</div>
                <div class="pv-metric-label">{m.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============== OVERVIEW ============== -->
      <section class="section pv-overview-section">
        <div class="container pv-overview-inner">
          <div class="reveal pv-overview-side">
            <div class="section-kicker">Overview</div>
            <h2 class="section-title">What is <span class="grad-text">{product.name}?</span></h2>
          </div>
          <div class="pv-overview-body reveal">
            <p class="pv-answer">{seo.answer}</p>
            <p>{product.summary}</p>
            {isDms ? (
              <ul class="pv-num-list">
                {dmsPillars.map((p) => (
                  <li><span class="pv-num-list-n">{p.n}</span><span>{p.text}</span></li>
                ))}
              </ul>
            ) : (
              <div class="pv-inline-block">
                <div class="pv-card-kicker">The challenges it replaces</div>
                <ul class="pv-chip-row">
                  {hrmsChallenges.map((c) => <li>{c}</li>)}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>

      {isDms ? (
        <>
          <!-- ============== DMS: ROLES ============== -->
          <section class="section pv-roles-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Role Architecture</div>
                <h2 class="section-title">Four roles, four dashboards: <span class="grad-text">supplier, distributor, dealer and direct dealer</span></h2>
                <p class="pv-head-lead">Each role has its own login, dashboard and permission set — RBAC enforced at the backend, not just hidden UI buttons.</p>
              </div>
              <div class="pv-roles-grid">
                {dmsRoles.map((r) => (
                  <article class:list={["pv-role-card", "reveal", r.accent && "is-accent"]}>
                    <div class="pv-role-num">{r.n}</div>
                    <h3>{r.title}</h3>
                    <div class="pv-role-kicker">{r.kicker}</div>
                    <p>{r.text}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== DMS: MODULES ============== -->
          <section class="section pv-modules-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Core Modules</div>
                <h2 class="section-title">Dealer management system features: <span class="grad-text">six modules on one data core</span></h2>
                <p class="pv-head-lead">Every module reads and writes the same real-time record. A sale at the counter moves stock, ledger, warranty and CRM in the same instant.</p>
              </div>
              <div class="mod-carousel reveal" data-mod-carousel>
                <div class="mod-track" aria-live="polite">
                  {dmsModules.map((m, i) => (
                    <article class="mod-card" data-mod-card data-slot={slotFor(i, dmsModules.length)} aria-roledescription="slide" aria-label={`${m.n} of 06: ${m.title}`}>
                      <div class="mod-card-head">
                        <span class="mod-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={moduleIcons[i]} />
                        </span>
                        <div>
                          <span class="mod-num">{m.n}</span>
                          <h3>{m.title}</h3>
                          <p class="mod-lead">{m.text}</p>
                        </div>
                      </div>
                      <ul class="mod-detail">
                        {m.detail.map((d) => <li>{d}</li>)}
                      </ul>
                    </article>
                  ))}
                </div>
                <div class="mod-controls">
                  <button class="mod-nav" type="button" data-mod-prev aria-label="Previous module">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                  </button>
                  <div class="mod-dots">
                    {dmsModules.map((m, i) => (
                      <button type="button" data-mod-dot={i} class:list={[i === 0 && 'is-active']} aria-label={`Show ${m.title}`}></button>
                    ))}
                  </div>
                  <button class="mod-nav" type="button" data-mod-next aria-label="Next module">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                  </button>
                </div>
              </div>

              <div class="pv-status-strip reveal">
                <span class="pv-card-kicker">Order status tracking</span>
                <div class="pv-mini-chain">
                  {dmsOrderStatus.map((s) => <span>{s}</span>)}
                </div>
              </div>
            </div>
          </section>

          <!-- ============== DMS: MATRIX ============== -->
          <section class="section pv-matrix-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Role-Based Feature Matrix</div>
                <h2 class="section-title">Role-based access control <span class="grad-text">across every module</span></h2>
                <p class="pv-head-lead">This is the core of the RBAC design. Choose a role to see what each module lets it do, and open any capability to compare it with the other roles.</p>
              </div>

              <div class="rbac reveal" data-rbac>
                <div class="rbac-tabs" role="tablist" aria-label="Choose a role">
                  {matrixRoles.map((r, i) => (
                    <button type="button" role="tab" class:list={['rbac-tab', i === 0 && 'is-active']} id={`rbac-tab-${i}`} aria-controls={`rbac-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-rbac-tab={i}>
                      {roleLabel(r)}
                    </button>
                  ))}
                </div>

                {matrixRoles.map((r, ri) => (
                  <div class="rbac-panel" role="tabpanel" id={`rbac-panel-${ri}`} aria-labelledby={`rbac-tab-${ri}`} hidden={ri !== 0} data-rbac-panel={ri}>
                    <p class="rbac-panel-title">{roleLabel(r)} capabilities</p>
                    {dmsMatrix.groups.map((g, gi) => (
                      <div class="rbac-group">
                        <div class="rbac-group-title">{g.title}</div>
                        {g.rows.map((row, i) => (
                          <details class="rbac-item" open={gi === 0 && i === 0}>
                            <summary>
                              <span class="rbac-num">{String(gi * dmsMatrix.groups[0].rows.length + i + 1).padStart(2, '0')}</span>
                              <span class="rbac-name">{row.module}</span>
                              <svg class="rbac-chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                            </summary>
                            <div class="rbac-body">
                              <p class="rbac-own">{row.cells[ri]}</p>
                              <dl class="rbac-compare">
                                {matrixRoles.map((other, oi) => oi !== ri && (
                                  <div>
                                    <dt>{roleLabel(other)}</dt>
                                    <dd>{row.cells[oi]}</dd>
                                  </div>
                                ))}
                              </dl>
                            </div>
                          </details>
                        ))}
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== DMS: CHANNELS ============== -->
          <section class="section pv-channels-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Process Flow</div>
                <h2 class="section-title">Two distribution channels, <span class="grad-text">one core</span></h2>
              </div>
              {dmsChannels.map((c) => (
                <div class="pv-channel reveal">
                  <div class="pv-channel-head">
                    <span class="pv-card-kicker">{c.label}</span>
                    <span class="pv-channel-note">{c.note}</span>
                  </div>
                  <div class="pv-channel-flow">
                    {c.steps.map((s) => (
                      <div class:list={["pv-channel-step", s.muted && "is-muted"]}>
                        <div class="pv-channel-step-title">{s.title}</div>
                        <p>{s.text}</p>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- ============== DMS: FOUNDATIONS ============== -->
          <section class="section pv-dark-section">
            <div class="container">
              <div class="reveal pv-head pv-head-dark">
                <div class="section-kicker">What Holds It Together</div>
                <h2 class="section-title">How PPV DMS works <span class="grad-text">under the hood</span></h2>
                <p class="pv-head-lead">Four behaviours run underneath every module. They are the reason the system stays consistent as the network scales.</p>
              </div>
              <div class="pv-foundations-grid">
                {dmsFoundations.map((f) => (
                  <article class="pv-foundation-card reveal">
                    <div class="pv-foundation-num">{f.n}</div>
                    <h3>{f.title}</h3>
                    <p>{f.text}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== DMS: AI ROADMAP ============== -->
          <section class="section pv-ai-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">AI Roadmap</div>
                <h2 class="section-title">AI features in PPV DMS: <span class="grad-text">a phased roadmap</span></h2>
                <p class="pv-head-lead">Reliable, working AI at the independent-dealer price point is a real market gap. Small players only claim AI; big platforms deliver it inconsistently.</p>
                <p class="pv-roadmap-note">These AI features are on the PPV DMS roadmap and are delivered in phases. Ask us which are available for your deployment today.</p>
              </div>
              <div class="pv-ai-grid">
                {dmsAiPhases.map((p) => (
                  <article class:list={["pv-ai-card", "reveal", p.accent && "is-accent"]}>
                    <div class="pv-ai-phase">{p.phase} — {p.weight}</div>
                    <h3>{p.title}</h3>
                    <ul class="pv-ai-list">
                      {p.items.map((i) => (
                        <li>
                          <span class="pv-ai-item">{i.text}</span>
                          <span class="pv-ai-roles">{i.roles}</span>
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== DMS: WHY ============== -->
          <section class="section pv-why-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Why It Is Different</div>
                <h2 class="section-title">DMS built for <span class="grad-text">handset distribution</span></h2>
                <p class="pv-head-lead">Generic ERPs and legacy automotive DMS platforms were designed for a different business. PPV DMS is designed around the four roles you actually operate, with strict API-level RBAC ensuring absolute data isolation.</p>
              </div>
              <div class="pv-why-grid pv-why-grid-3">
                {dmsDifferentiators.map((d) => (
                  <article class="pv-why-card reveal">
                    <div class="pv-card-kicker">{d.kicker}</div>
                    <p>{d.text}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== DMS: VS ERP ============== -->
          <section class="section compare-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">DMS vs ERP</div>
                <h2 class="section-title">Dealer management system vs ERP: <span class="grad-text">what's the difference?</span></h2>
                <p class="pv-head-lead">A general ERP is built to run a company's finance, procurement and operations broadly. It treats channel partners as customers or vendors sitting outside the system. A dealer management system is built around the channel itself: allocating stock down the tiers, giving every distributor and dealer their own scoped view, tracking each unit by serial number, applying schemes at billing and handling warranty after the sale. Automotive DMS platforms solve this for vehicle dealers; PPV DMS solves it for multi-tier handset distribution, so the supplier, distributors, dealers and direct dealers all work from the same real-time record.</p>
              </div>
              <div class="pv-table-scroll reveal">
                <table class="pv-table compare-table">
                  <thead>
                    <tr>
                      <th scope="col"><span class="visually-hidden">System</span></th>
                      <th scope="col">Built around</th>
                      <th scope="col">Channel partners</th>
                      <th scope="col">Unit tracking</th>
                      <th scope="col">After-sales</th>
                    </tr>
                  </thead>
                  <tbody>
                    {dmsVsErp.map((r) => (
                      <tr class:list={[r.name === 'PPV DMS' && 'is-highlight-row']}>
                        <th scope="row">{r.name}</th>
                        <td>{r.scope}</td>
                        <td>{r.channel}</td>
                        <td>{r.units}</td>
                        <td>{r.after}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        </>
      ) : (
        <>
          <!-- ============== HRMS: CAPABILITIES ============== -->
          <section class="section pv-modules-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Core Capabilities</div>
                <h2 class="section-title">HRMS features: <span class="grad-text">10 integrated modules in one platform</span></h2>
                <p class="pv-head-lead">Ten core capabilities, delivered as one fully integrated ecosystem rather than a patchwork of point tools.</p>
              </div>
              <div class="pv-cap-grid">
                {hrmsCapabilities.map((c, i) => (
                  <div class="pv-cap-item reveal">
                    <span class="pv-cap-num">{String(i + 1).padStart(2, '0')}</span>
                    <span>{c}</span>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== HRMS: LIFECYCLE ============== -->
          <section class="section pv-lifecycle-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Employee Lifecycle</div>
                <h2 class="section-title">Employee lifecycle management, <span class="grad-text">from onboarding to offboarding</span></h2>
              </div>
              <div class="pv-lifecycle-grid">
                {hrmsLifecycle.map((l) => (
                  <article class="pv-lifecycle-card reveal">
                    <div class="pv-lifecycle-num">{l.n}</div>
                    <h3>{l.title}</h3>
                    <p>{l.text}</p>
                  </article>
                ))}
              </div>
              <div class="pv-balance reveal">
                <span class="pv-balance-label">One platform</span>
                <span>Hire</span><span>Develop</span><span>Retain</span><span>Empower</span>
              </div>
            </div>
          </section>

          <!-- ============== HRMS: MODULE CATEGORIES ============== -->
          <section class="section pv-modules-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Module Categories</div>
                <h2 class="section-title">HR module <span class="grad-text">categories</span></h2>
                <p class="pv-head-lead">Five categories and more than fifteen functional modules — a single, connected system replacing the patchwork of spreadsheets and point tools.</p>
              </div>
              <div class="pv-catgrid">
                {hrmsCategories.map((c) => (
                  <article class="pv-cat-card reveal">
                    <div class="pv-cat-num">{c.n}</div>
                    <h3>{c.title}</h3>
                    <ul class="pv-tick-list pv-tick-sm">
                      {c.items.map((i) => <li>{i}</li>)}
                    </ul>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== HRMS: ROLES ============== -->
          <section class="section pv-dark-section">
            <div class="container">
              <div class="reveal pv-head pv-head-dark">
                <div class="section-kicker">Access &amp; Governance</div>
                <h2 class="section-title">Role-based access <span class="grad-text">and HR data governance</span></h2>
                <p class="pv-head-lead">Granular permissions ensure sensitive information stays with the right people — nothing more, nothing less.</p>
              </div>
              <div class="pv-foundations-grid pv-foundations-grid-4">
                {hrmsRoles.map((r) => (
                  <article class="pv-foundation-card reveal">
                    <div class="pv-foundation-num">{r.n}</div>
                    <h3>{r.title}</h3>
                    <p>{r.text}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <!-- ============== HRMS: INTEGRATIONS ============== -->
          <section class="section pv-integrations-section">
            <div class="container">
              <div class="reveal pv-head">
                <div class="section-kicker">Integrations</div>
                <h2 class="section-title">HRMS integrations: <span class="grad-text">biometric, payroll banking, ERP and SSO</span></h2>
                <p class="pv-head-lead">Native connectors and open interfaces across identity, communication, finance and operations. Designed to extend your ecosystem — not replace it.</p>
              </div>
              <div class="pv-why-grid pv-why-grid-3">
                {hrmsIntegrations.map((i) => (
                  <article class="pv-why-card reveal">
                    <div class="pv-card-kicker">{i.kicker}</div>
                    <h3 class="pv-why-title">{i.title}</h3>
                    <ul class="pv-tick-list pv-tick-sm">
