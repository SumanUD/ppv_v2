---
import Base from '@/layouts/Base.astro';
import PageAurora from '@/components/PageAurora.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

import AboutHero from '@/components/sections/about/AboutHero.astro';
import GoldenCircle from '@/components/sections/about/GoldenCircle.astro';
import WhyHowWhat from '@/components/sections/about/WhyHowWhat.astro';
import WayWeSeeBrands from '@/components/sections/about/WayWeSeeBrands.astro';
import MarketChanging from '@/components/sections/about/MarketChanging.astro';
import Vector from '@/components/sections/about/Vector.astro';
import PartnershipPhilosophy from '@/components/sections/about/PartnershipPhilosophy.astro';
import WhoWeWorkBestWith from '@/components/sections/about/WhoWeWorkBestWith.astro';
import AboutCta from '@/components/sections/about/AboutCta.astro';
import AboutIntro from '@/components/sections/about/AboutIntro.astro';
import PageFaq from '@/components/PageFaq.astro';
import { pageFaqs, faqPageSchema } from '@/data/faqs';
import aboutSchema from '@/data/seo/about.json';

const faqs = pageFaqs['/about/'];
---

<Base
  title="About Us | Strategic Growth Company in Kolkata | PPV"
  description="Platform Play Venture is a Kolkata-based strategic growth company combining strategy, fractional CMO governance, technology and training. See how we work."
  breadcrumbs={[{ name: 'About', path: '/about/' }]}
  schema={[aboutSchema, faqPageSchema('/about/', faqs)]}
>
  <ScrollProgress />

  <div class="site-shell is-ready">
    <PageAurora />
    <Nav />

    <main class="about-page">
      <AboutHero />
      <AboutIntro />
      <GoldenCircle />
      <WhyHowWhat />
      <WayWeSeeBrands />
      <MarketChanging />
      <Vector />
      <PartnershipPhilosophy />
      <WhoWeWorkBestWith />
      <PageFaq title="Frequently asked questions about Platform Play Venture" faqs={faqs} />
      <AboutCta />
    </main>

    <Footer />
  </div>

  <script>
    import '@/scripts/site.ts';
    import '@/scripts/about.ts';
  </script>
</Base>
