---
import Base from '@/layouts/Base.astro';
import PageAurora from '@/components/PageAurora.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/sections/Contact.astro';
import SocialIcons from '@/components/SocialIcons.astro';
import PageFaq from '@/components/PageFaq.astro';
import { contact, fullAddress, website } from '@/data/site';
import { pageFaqs, faqPageSchema } from '@/data/faqs';
import contactSchema from '@/data/seo/contact.json';

const faqs = pageFaqs['/contact/'];
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
const nextSteps = [
  { title: 'We reply within one business day', text: 'Your enquiry reaches our team directly, and you get a confirmation by email straight away.' },
  { title: 'A 30-minute fit-check call', text: 'A no-obligation conversation to understand where your business is today and what it is trying to achieve.' },
  { title: 'A clear recommendation', text: 'You leave with an honest view of the next step — whether that involves PPV or not.' },
];
---

<Base
  title="Contact Platform Play Venture | Book a Strategy Call"
  description={`Talk to Platform Play Venture about strategy, fractional CMO support, technology or training. Call ${contact.phone} or send us a message today.`}
  breadcrumbs={[{ name: 'Contact', path: '/contact/' }]}
  schema={[contactSchema, faqPageSchema('/contact/', faqs)]}
>
  <ScrollProgress />

  <div class="site-shell is-ready">
    <PageAurora />
    <Nav />

    <main class="service-page contact-page">
      <section class="service-hero contact-page-hero">
        <div class="service-hero-bg" aria-hidden="true">
          <span class="service-hero-blob a"></span>
          <span class="service-hero-blob b"></span>
        </div>
        <div class="container service-hero-inner">
          <div class="service-hero-eyebrow reveal"><span class="pulse-dot"></span><span>Let's connect</span></div>
          <h1 class="service-hero-title reveal">Contact <span class="grad-text">Platform Play Venture</span></h1>
          <p class="service-hero-lead reveal">Tell us where your business is today and we'll suggest a clear next step. Whether you have a business enquiry, want to explore a collaboration or simply wish to know more about Platform Play Venture, we're here to connect.</p>
          <a class="connect-cta reveal" href="#contact">Share your enquiry <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <Contact title="Tell us where your business is today" kicker="Send us a message" lead="Share a few details and the right person on our team will get back to you." />

      <section class="section reach-section">
        <div class="container">
          <div class="reveal pv-head">
            <div class="section-kicker">Reach us</div>
            <h2 class="section-title">Other ways to <span class="grad-text">reach us</span></h2>
          </div>
          <div class="reach-grid">
            <div class="connect-panel connect-panel-stack reveal">
              <div class="connect-block">
                <h3 class="connect-heading">Get in touch</h3>
                <ul class="connect-list">
                  <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <a href={`mailto:${contact.email}`}>{contact.email}</a>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <a href={contact.phoneHref}>{contact.phone}</a>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>Mon–Fri, 9:00–18:00</span>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <a href={website}>{website.replace('https://', '')}</a>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <address>{fullAddress}</address>
                  </li>
                </ul>
              </div>
              <div class="connect-block">
                <h3 class="connect-heading">Follow our journey</h3>
                <p>Stay connected with our ideas, perspectives and updates across our social platforms.</p>
                <SocialIcons class="connect-social" labels />
              </div>
            </div>
            <div class="reach-map reveal">
              <iframe
                title={`Map: ${fullAddress}`}
                src={mapSrc}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <section class="section pv-phases-section">
        <div class="container">
          <div class="reveal pv-head">
            <div class="section-kicker">What to expect</div>
            <h2 class="section-title">What happens after <span class="grad-text">you get in touch</span></h2>
          </div>
          <ol class="pv-phase-list">
            {nextSteps.map((s, i) => (
              <li class="pv-phase reveal">
                <span class="pv-phase-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="pv-phase-body">
                  <h3 class="pv-phase-title">{s.title}</h3>
                  <span class="pv-phase-text">{s.text}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <PageFaq title="Contact FAQs" faqs={faqs} />
    </main>

    <Footer />
  </div>

  <script>
    import '@/scripts/site.ts';
  </script>
</Base>
