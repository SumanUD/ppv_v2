---
import { contact } from '@/data/site';
import { pageFaqs } from '@/data/faqs';

const faqs = pageFaqs['/'];
---
<section class="section faq-section" id="faq">
  <div class="faq-ambient" aria-hidden="true">
    <span class="faq-blob faq-blob-a"></span>
    <span class="faq-blob faq-blob-b"></span>
  </div>

  <div class="container">
    <div class="reveal faq-header">
      <div class="section-kicker">Clarity before the first conversation</div>
      <h2 class="section-title">Frequently Asked Questions about <span class="grad-text">Platform Play Venture</span></h2>
      <p class="section-lead">Most businesses arrive with similar questions about how the engagement works, what the process looks like, and what they can realistically expect.</p>
    </div>

    <div class="faq-shell">
      <!-- Left rail: contextual help card -->
      <aside class="faq-rail reveal">
        <div class="faq-rail-tag">
          <span class="pulse-dot"></span>
          <span>Need More?</span>
        </div>
        <h3>Have a business challenge to solve?</h3>
        <p>Every business has different goals, challenges and growth opportunities. Tell us what you're looking to achieve. Let's explore how strategy, marketing and technology can help move your business forward.</p>
        <a class="faq-rail-cta" href="#contact">
          <span>Share Your Enquiry</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="faq-rail-alt">Prefer email? <a href={`mailto:${contact.email}`}>{contact.email}</a></p>

        <div class="faq-rail-divider"></div>

        <ul class="faq-rail-list">
          <li><span class="faq-rail-num">{faqs.length}</span> Common questions</li>
          <li><span class="faq-rail-num">~24h</span> Avg response time</li>
          <li><span class="faq-rail-num">1:1</span> Direct conversations</li>
        </ul>
      </aside>

      <!-- Right: accordion list -->
      <div class="faq-list reveal">
        {faqs.map(([q, a], i) => (
          <details class="faq-item" open={i === 0} data-faq-item>
            <summary>
              <span class="faq-q-index">Q{i + 1}</span>
              <span class="faq-q">{q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer">
              <p>{a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
