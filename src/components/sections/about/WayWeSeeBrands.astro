---
const slides = [
  {
    n: 1,
    accent: 'dairy',
    tag: '01 · Emotion',
    pillarKeywords: 'CELEBRATION  ·  WARMTH  ·  GIFTING',
    statement: 'Brands are remembered emotionally before they are understood logically.',
    brand: 'Cadbury Dairy Milk',
    copy: 'People rarely choose Dairy Milk through rational comparison. What stays with them is celebration, warmth, gifting, and childhood familiarity built over generations. The emotional connection shapes preference long before logic does.'
  },
  {
    n: 2,
    accent: 'apple',
    tag: '02 · Meaning',
    pillarKeywords: 'WHAT IT REPRESENTS  ≠  WHAT IT SELLS',
    statement: 'Visibility creates attention. Meaning creates recall.',
    brand: 'Apple',
    copy: "Apple's recall comes from what it represents — not only what it sells. Simplicity, creativity, design, aspiration, and intuitive experience are what people remember over time."
  },
  {
    n: 3,
    accent: 'enfield',
    tag: '03 · Identity',
    pillarKeywords: 'EXPLORATION  ·  INDIVIDUALITY  ·  WAY OF LIFE',
    statement: 'Consumers do not choose brands. They recognise themselves in them.',
    brand: 'Royal Enfield',
    copy: 'Royal Enfield represents more than motorcycles. For many riders, it reflects exploration, individuality, and a way of life people emotionally identify with.'
  },
  {
    n: 4,
    accent: 'amul',
    tag: '04 · Carry-Forward',
    pillarKeywords: 'TRUST  ·  FAMILIARITY  ·  EVERYDAY',
    statement: 'Positioning is not what a brand says. It is what people carry forward.',
    brand: 'Amul',
    copy: 'Amul became more than a dairy brand over time. It came to represent trust, familiarity, consistency, and everyday Indian households. That long-term perception became its real positioning.'
  },
  {
    n: 5,
    accent: 'airbnb',
    tag: '05 · Shift',
    pillarKeywords: 'WHEN PERCEPTION SHIFTS  ·  BEHAVIOUR FOLLOWS',
    statement: 'The market responds differently when perception changes.',
    brand: 'Airbnb',
    copy: 'Airbnb changed travel from "booking accommodation" to "belonging anywhere." As the perception evolved, consumer behaviour evolved with it.'
  },
];
const total = slides.length;
---

<section class="way-section" id="way-we-see-brands">
  <div class="way-ambient" aria-hidden="true">
    <span class="way-blob way-blob-a"></span>
    <span class="way-blob way-blob-b"></span>
  </div>

  <div class="container way-intro reveal">
    <div class="section-kicker">The Way We See Brands</div>
    <h2 class="section-title">The market responds <span class="grad-text">emotionally, behaviourally, psychologically</span> — long before decisions become visible externally.</h2>
  </div>

  {slides.map((s) => (
    <article class="way-slide reveal" data-way-slide={s.n - 1} data-accent={s.accent}>
      <div class="way-slide-inner">
        <!-- LEFT 40% -->
        <div class="way-left">
          <div class="way-left-progress" aria-hidden="true">
            <span class="way-progress-num">{String(s.n).padStart(2, '0')}</span>
            <span class="way-progress-of">/ {String(total).padStart(2, '0')}</span>
          </div>
          <span class="way-statement-quote" aria-hidden="true">"</span>
          <h3 class="way-statement">{s.statement}</h3>
          <span class="way-brand-name">{s.brand}</span>
          <div class="way-progress-bar" aria-hidden="true">
            <span class="way-progress-fill" style={`transform: scaleX(${s.n / total});`}></span>
          </div>
        </div>

        <!-- RIGHT 60% -->
        <div class="way-right">
          <div class="way-panel-card" data-accent={s.accent}>
            <div class="way-panel-tag">{s.tag}</div>
            {s.accent === 'dairy' && (
              <svg viewBox="0 0 540 540" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <linearGradient id="dairyBg" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#2A0E0E"/>
                    <stop offset="100%" stop-color="#5B1F1A"/>
                  </linearGradient>
                  <linearGradient id="dairyFoil" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#7E2E22"/>
                    <stop offset="50%" stop-color="#9B3B2A"/>
                    <stop offset="100%" stop-color="#5B1F1A"/>
                  </linearGradient>
                </defs>
                <rect width="540" height="540" fill="url(#dairyBg)"/>
                <g transform="translate(150, 130) rotate(-8 120 140)">
                  <rect width="240" height="280" rx="14" fill="url(#dairyFoil)" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
                  <g fill="#FFB066" font-family="Space Grotesk" font-weight="700" letter-spacing="0.04em">
                    <text x="120" y="100" text-anchor="middle" font-size="24">Cadbury</text>
                    <text x="120" y="138" text-anchor="middle" font-size="34" fill="#FFFFFF">Dairy</text>
                    <text x="120" y="174" text-anchor="middle" font-size="34" fill="#FFFFFF">Milk</text>
                  </g>
                  <g stroke="#FFB066" stroke-width="1.2" fill="none" opacity="0.7">
                    <path d="M 30 220 Q 80 200, 130 220 T 220 220"/>
                  </g>
                  <g fill="#FFB066" opacity="0.85">
                    <circle cx="58" cy="240" r="4"/>
                    <circle cx="120" cy="232" r="4"/>
                    <circle cx="182" cy="240" r="4"/>
                  </g>
                </g>
                <g opacity="0.65">
                  <circle cx="100" cy="100" r="60" fill="rgba(238, 90, 24, 0.18)"/>
                  <circle cx="440" cy="440" r="80" fill="rgba(255, 176, 102, 0.16)"/>
                </g>
                <text x="270" y="490" text-anchor="middle" font-family="JetBrains Mono" font-size="11" font-weight="500" fill="#FFE3CC" letter-spacing="3">{s.pillarKeywords}</text>
              </svg>
            )}
            {s.accent === 'apple' && (
              <svg viewBox="0 0 540 540" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <linearGradient id="appleBg" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#0E0E0E"/>
                    <stop offset="100%" stop-color="#222"/>
                  </linearGradient>
                </defs>
                <rect width="540" height="540" fill="url(#appleBg)"/>
                <ellipse cx="270" cy="0" rx="320" ry="240" fill="rgba(255, 255, 255, 0.10)"/>
                <ellipse cx="270" cy="540" rx="200" ry="80" fill="rgba(238, 90, 24, 0.18)"/>
                <g transform="translate(270 280)">
                  <path d="M 0 -80 Q -80 -80 -90 -20 Q -100 60 -50 90 Q 0 110 50 90 Q 100 60 90 -20 Q 80 -80 0 -80 Z" fill="rgba(255, 255, 255, 0.92)"/>
                  <path d="M -8 -76 Q -12 -94 4 -100 Q 18 -92 14 -76" fill="rgba(255, 255, 255, 0.92)"/>
                </g>
                <g font-family="JetBrains Mono" font-size="11" font-weight="500" fill="#FFFFFF" letter-spacing="3.6" opacity="0.6">
                  <text x="60" y="80">SIMPLICITY</text>
                  <text x="60" y="120">CREATIVITY</text>
                  <text x="60" y="160">DESIGN</text>
                  <text x="380" y="420">ASPIRATION</text>
                  <text x="380" y="460">INTUITION</text>
                </g>
                <text x="270" y="510" text-anchor="middle" font-family="JetBrains Mono" font-size="11" font-weight="500" fill="#FFE3CC" letter-spacing="3">{s.pillarKeywords}</text>
              </svg>
            )}
            {s.accent === 'enfield' && (
              <svg viewBox="0 0 540 540" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <linearGradient id="enfieldBg" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#2A1A0A"/>
                    <stop offset="100%" stop-color="#1A1004"/>
                  </linearGradient>
                  <radialGradient id="enfieldSun" cx="50%" cy="35%" r="50%">
                    <stop offset="0%" stop-color="#FFB066" stop-opacity="0.95"/>
                    <stop offset="50%" stop-color="#EE5A18" stop-opacity="0.6"/>
                    <stop offset="100%" stop-color="#EE5A18" stop-opacity="0"/>
                  </radialGradient>
                </defs>
                <rect width="540" height="540" fill="url(#enfieldBg)"/>
                <circle cx="270" cy="200" r="180" fill="url(#enfieldSun)"/>
                <circle cx="270" cy="200" r="80" fill="rgba(255, 176, 102, 0.8)"/>
                <rect x="0" y="360" width="540" height="180" fill="rgba(0, 0, 0, 0.6)"/>
                <path d="M 0 360 L 100 290 L 180 340 L 280 250 L 380 320 L 460 280 L 540 360 Z" fill="#0E0E0E"/>
                <g transform="translate(220 340)" fill="#0E0E0E">
                  <circle cx="20" cy="50" r="22"/>
                  <circle cx="80" cy="50" r="22"/>
                  <path d="M 20 50 L 50 20 L 80 50 Z"/>
                  <path d="M 20 50 L 0 30 L 10 14 L 30 28 L 50 20"/>
                  <path d="M 48 22 L 56 0 L 62 -12 L 50 -16 L 40 -10 Z"/>
                  <circle cx="46" cy="-18" r="9"/>
                </g>
                <text x="270" y="510" text-anchor="middle" font-family="JetBrains Mono" font-size="11" font-weight="500" fill="#FFE3CC" letter-spacing="3">{s.pillarKeywords}</text>
              </svg>
            )}
            {s.accent === 'amul' && (
              <svg viewBox="0 0 540 540" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <linearGradient id="amulBg" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#3D1A05"/>
                    <stop offset="100%" stop-color="#7A2410"/>
                  </linearGradient>
                </defs>
                <rect width="540" height="540" fill="url(#amulBg)"/>
                <rect x="0" y="0" width="540" height="220" fill="rgba(238, 90, 24, 0.5)"/>
                <circle cx="440" cy="100" r="36" fill="#FFE3CC" opacity="0.9"/>
                <g fill="#FFFFFF">
                  <rect x="60" y="280" width="100" height="120"/>
                  <path d="M 50 280 L 110 230 L 170 280 Z"/>
                  <rect x="100" y="320" width="20" height="40" fill="#7A2410"/>
                  <rect x="180" y="260" width="120" height="140"/>
                  <path d="M 170 260 L 240 200 L 310 260 Z"/>
                  <rect x="220" y="300" width="20" height="40" fill="#7A2410"/>
                  <rect x="260" y="300" width="20" height="20" fill="#FFB066"/>
                  <rect x="320" y="290" width="100" height="110"/>
                  <path d="M 310 290 L 370 240 L 430 290 Z"/>
                  <rect x="360" y="330" width="20" height="40" fill="#7A2410"/>
                </g>
                <rect x="0" y="400" width="540" height="140" fill="#1A0D03"/>
                <g transform="translate(40 40)">
                  <circle cx="0" cy="0" r="22" fill="#EE5A18"/>
                  <circle cx="0" cy="0" r="22" fill="none" stroke="#FFFFFF" stroke-width="3"/>
                  <text x="0" y="6" text-anchor="middle" font-family="Space Grotesk" font-size="14" font-weight="700" fill="#FFFFFF">A</text>
                </g>
                <text x="270" y="510" text-anchor="middle" font-family="JetBrains Mono" font-size="11" font-weight="500" fill="#FFE3CC" letter-spacing="3">{s.pillarKeywords}</text>
              </svg>
            )}
            {s.accent === 'airbnb' && (
              <svg viewBox="0 0 540 540" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <linearGradient id="airbnbBg" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#1A1A1A"/>
                    <stop offset="100%" stop-color="#2A0E0E"/>
                  </linearGradient>
                </defs>
                <rect width="540" height="540" fill="url(#airbnbBg)"/>
                <g fill="rgba(255, 255, 255, 0.08)">
                  <rect x="0" y="200" width="80" height="200"/>
                  <rect x="80" y="240" width="100" height="160"/>
                  <rect x="180" y="180" width="60" height="220"/>
                  <rect x="240" y="220" width="80" height="180"/>
                  <rect x="320" y="160" width="100" height="240"/>
                  <rect x="420" y="240" width="120" height="160"/>
                </g>
                <g fill="#FFB066" opacity="0.85">
                  <rect x="20" y="220" width="6" height="6"/>
                  <rect x="40" y="240" width="6" height="6"/>
                  <rect x="100" y="260" width="6" height="6"/>
                  <rect x="140" y="280" width="6" height="6"/>
                  <rect x="200" y="200" width="6" height="6"/>
                  <rect x="260" y="240" width="6" height="6"/>
                  <rect x="340" y="180" width="6" height="6"/>
                  <rect x="380" y="220" width="6" height="6"/>
                  <rect x="460" y="260" width="6" height="6"/>
                </g>
                <g stroke="#EE5A18" stroke-width="2" fill="none">
                  <path d="M 60 400 Q 270 240, 480 400" stroke-dasharray="5 6"/>
                  <circle cx="60" cy="400" r="9" fill="#FFFFFF" stroke="#EE5A18" stroke-width="2"/>
                  <circle cx="480" cy="400" r="9" fill="#EE5A18"/>
                </g>
                <g font-family="JetBrains Mono" font-size="11" font-weight="600" fill="#FFFFFF" letter-spacing="2.5">
                  <text x="60" y="430" text-anchor="middle" opacity="0.7">BOOKING</text>
                  <text x="480" y="430" text-anchor="middle">BELONGING</text>
                </g>
                <text x="270" y="510" text-anchor="middle" font-family="JetBrains Mono" font-size="11" font-weight="500" fill="#FFE3CC" letter-spacing="3">{s.pillarKeywords}</text>
              </svg>
            )}
          </div>
          <p class="way-panel-copy">{s.copy}</p>
        </div>
      </div>
    </article>
  ))}
</section>
