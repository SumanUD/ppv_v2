        <div class="pb-art" aria-hidden="true">
          <svg viewBox="0 0 220 160" xmlns="http://www.w3.org/2000/svg">
            <g fill="#7E7B73" opacity="0.16">
              <circle cx="22" cy="24" r="1.3"/><circle cx="44" cy="24" r="1.3"/><circle cx="66" cy="24" r="1.3"/>
              <circle cx="22" cy="46" r="1.3"/><circle cx="44" cy="46" r="1.3"/>
              <circle cx="190" cy="26" r="1.3"/><circle cx="190" cy="120" r="1.3"/>
              <circle cx="26" cy="134" r="1.3"/>
            </g>
