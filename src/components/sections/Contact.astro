---
import { contact, fullAddress } from '@/data/site';
import SocialIcons from '@/components/SocialIcons.astro';
---
<section class="contact-section" id="contact">
  <div class="contact-aurora" aria-hidden="true">
    <span class="contact-blob b1"></span>
    <span class="contact-blob b2"></span>
    <span class="contact-blob b3"></span>
    <div class="contact-grid-bg"></div>
  </div>

  <div class="container">
    <div class="contact-header reveal">
      <div class="section-kicker">Ready to Transform</div>
      <h2 class="section-title contact-title">It's time to <span class="grad-text">connect.</span></h2>
      <p class="section-lead contact-lead">Let's turn your data, strategy, and curiosity into decisions that move markets.</p>
    </div>

    <div class="contact-shell">
      <!-- LEFT: form -->
      <!-- Posts to the contact mailer on the VPS (server/contact-mailer), proxied by nginx. -->
      <form class="contact-form reveal" action="/api/contact" method="POST" novalidate data-contact-form>
        <input type="checkbox" name="botcheck" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="form" value="contact" />
        <input type="hidden" name="engagement" value="Strategic" data-engagement-input />
        <div class="contact-form-head">
          <div class="contact-form-status">
            <span class="pulse-dot"></span>
            <span>Awaiting your message</span>
          </div>
          <div class="contact-form-id">FORM-2026</div>
        </div>

        <div class="form-grid">
          <div class="form-field">
            <input type="text" id="name" name="name" required minlength="2" maxlength="100" placeholder=" " autocomplete="name" aria-describedby="name-error" />
            <label for="name">Your name</label>
            <span class="form-field-bar"></span>
            <span class="form-error" id="name-error" data-error-for="name"></span>
          </div>
          <div class="form-field">
            <input type="email" id="email" name="email" required maxlength="254" placeholder=" " autocomplete="email" aria-describedby="email-error" />
            <label for="email">Email address</label>
            <span class="form-field-bar"></span>
            <span class="form-error" id="email-error" data-error-for="email"></span>
          </div>
          <div class="form-field">
            <input type="tel" id="phone" name="phone" required inputmode="numeric" pattern="[0-9]{10}" placeholder=" " autocomplete="tel" aria-describedby="phone-error" />
            <label for="phone">Phone number</label>
            <span class="form-field-bar"></span>
            <span class="form-error" id="phone-error" data-error-for="phone"></span>
          </div>
        </div>

        <div class="form-field form-field-full">
          <textarea id="message" name="message" rows="5" required minlength="10" maxlength="5000" placeholder=" " aria-describedby="message-error"></textarea>
          <label for="message">How can we help?</label>
          <span class="form-field-bar"></span>
          <span class="form-error" id="message-error" data-error-for="message"></span>
        </div>

        <div class="form-actions">
          <button type="submit" class="button button-primary contact-submit">
            <span>Send Message</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <span class="form-note">We typically respond within one business day.</span>
        </div>

        <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>
      </form>

      <!-- RIGHT: info panel -->
      <aside class="contact-info reveal">
        <div class="contact-info-card">
          <div class="contact-info-tag">
            <span class="pulse-dot"></span>
            <span>Operations · Live</span>
          </div>
          <h3>Three ways to begin.</h3>
          <p class="contact-info-lede">Every conversation starts the same way — with clarity. Choose how you'd like to reach us.</p>

          <ul class="contact-channels">
            <li class="contact-channel">
              <span class="contact-channel-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <div>
                <span class="contact-channel-label">Email</span>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </div>
            </li>
            <li class="contact-channel">
              <span class="contact-channel-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <div>
                <span class="contact-channel-label">Call</span>
                <a href={contact.phoneHref}>{contact.phone}</a>
              </div>
            </li>
            <li class="contact-channel contact-channel-social">
              <span class="contact-channel-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                </svg>
              </span>
              <div>
                <span class="contact-channel-label">Social</span>
                <SocialIcons class="contact-social" />
              </div>
            </li>
          </ul>

          <address class="contact-address">
            <span class="contact-meta-label">Office</span>
            <span>{fullAddress}</span>
          </address>

          <div class="contact-info-divider"></div>

          <div class="contact-meta-grid">
            <div>
              <span class="contact-meta-label">Response</span>
              <span class="contact-meta-val">&lt; 24h</span>
            </div>
            <div>
              <span class="contact-meta-label">Engagement</span>
              <span class="contact-meta-val" data-engagement-display>Strategic</span>
            </div>
            <div>
              <span class="contact-meta-label">Fit Check</span>
              <span class="contact-meta-val">First Call</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
