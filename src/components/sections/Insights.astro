---
import { insights, insightPath } from '@/data/insights';

const latest = insights.slice(0, 4);
---
<section class="section insights-section" id="insights">
  <div class="insights-ambient" aria-hidden="true">
    <span class="insights-blob insights-blob-a"></span>
    <span class="insights-blob insights-blob-b"></span>
  </div>

  <div class="container">
    <div class="reveal insights-header">
      <div class="section-kicker">Insights</div>
      <h2 class="section-title">Perspectives shaped by <span class="grad-text">real brand experience</span></h2>
      <p class="section-lead">Field notes from working with brands at the thinking layer — what we observe, what we test, and what we learn while shaping strategy, perception, and decisions.</p>
    </div>

    <div class:list={['insights-grid', { 'is-single': latest.length === 1 }]}>
      {latest.map((e) => (
        <article class="insight-card reveal">
          <a class="insight-card-media" href={insightPath(e.slug)} tabindex="-1" aria-hidden="true">
            <img src={e.image} alt="" width={e.imageWidth} height={e.imageHeight} loading="lazy" decoding="async" />
          </a>
          <div class="insight-card-body">
            <div class="insight-card-tag">
              <span class="insight-card-kind">{e.tag}</span>
              <span class="insight-card-meta">{e.readTime}</span>
            </div>
            <h3>{e.title}</h3>
            <p>{e.excerpt}</p>
            <a class="insight-card-link" href={insightPath(e.slug)}>
              <span>Read the article</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="insights-foot reveal">
      <a class="insights-foot-cta" href="/insights/">
        <span>View all blogs</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>
