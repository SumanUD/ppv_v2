---
import { contact, fullAddress } from '@/data/site';
import SocialIcons from '@/components/SocialIcons.astro';

const isHome = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/';
const h = (anchor: string) => (isHome ? `#${anchor}` : `/#${anchor}`);
// On the homepage the form is on the page; everywhere else use the contact page.
const contactHref = isHome ? '#contact' : '/contact/';
---
<footer class="footer">
  <div class="footer-ambient" aria-hidden="true">
    <span class="footer-blob a"></span>
    <span class="footer-blob b"></span>
    <div class="footer-grid-bg"></div>
  </div>

  <div class="container">
    <!-- CTA banner -->
    <div class="footer-cta reveal">
      <div class="footer-cta-inner">
        <div class="footer-cta-eyebrow">
          <span class="pulse-dot"></span>
          <span>Take the next step</span>
        </div>
        <h2 class="footer-cta-title">Clarity is closer than <span class="grad-text">you think.</span></h2>
        <p class="footer-cta-copy">Tell us where the brand is today. We'll show you where it can go — and the structure to get there.</p>
        <div class="footer-cta-actions">
          <a class="button button-primary" href={contactHref}>
            <span>Begin the Conversation</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a class="footer-cta-link" href={h('solutions')}>
            <span>See what we do</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-cta-decor" aria-hidden="true">
        <span class="footer-cta-orb"></span>
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="footerRing" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#EE5A18"/>
              <stop offset="60%" stop-color="#FF8A3D"/>
              <stop offset="100%" stop-color="#FFB066"/>
            </linearGradient>
          </defs>
          <circle cx="100" cy="100" r="78" fill="none" stroke="url(#footerRing)" stroke-width="1.4" stroke-dasharray="3 7"/>
          <circle cx="100" cy="100" r="52" fill="none" stroke="rgba(14, 14, 14, 0.18)" stroke-width="1"/>
          <circle cx="100" cy="100" r="32" fill="rgba(238, 90, 24, 0.10)"/>
          <circle cx="100" cy="100" r="16" fill="rgba(238, 90, 24, 0.6)"/>
          <circle cx="178" cy="100" r="4" fill="#FFB066"/>
          <circle cx="22" cy="100" r="4" fill="#EE5A18"/>
          <circle cx="100" cy="22" r="4" fill="#FF8A3D"/>
        </svg>
      </div>
    </div>

    <!-- Main footer columns -->
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-logo" href={h('home')} aria-label="Platform Play Venture home">
          <img class="footer-logo-img" src="/newlogo.png" alt="Platform Play Venture maze" width="240" height="220" />
          <span class="footer-logo-name" aria-hidden="true">
            <span>PLATFORM</span><span class="play">PLAY</span><span>VENTURE</span>
          </span>
        </a>
        <p class="footer-description">A strategic growth and transformation company that brings business strategy, marketing and technology together to build connected ecosystems. We help businesses create clarity, strengthen decision-making and drive sustainable growth through purposeful strategy and execution.</p>
        <div class="footer-meta">
          <div>
            <span class="footer-meta-label">Hours</span>
            <span class="footer-meta-val">{contact.hours}</span>
          </div>
          <div>
            <span class="footer-meta-label">Reach</span>
            <a class="footer-meta-val" href={`mailto:${contact.email}`}>{contact.email}</a>
          </div>
          <div>
            <span class="footer-meta-label">Call</span>
            <a class="footer-meta-val" href={contact.phoneHref}>{contact.phone}</a>
          </div>
          <div>
            <span class="footer-meta-label">Office</span>
            <address class="footer-meta-val">{fullAddress}</address>
          </div>
        </div>
      </div>

      <div class="footer-col">
        <div class="footer-heading">Explore</div>
        <div class="footer-links">
          <a href={isHome ? '#home' : '/'}>Home</a>
          <a href="/about/">About</a>
          <a href={h('solutions')}>Solutions</a>
          <a href="/insights/">Insights</a>
        </div>
      </div>

      <div class="footer-col">
        <div class="footer-heading">Reach Us</div>
        <div class="footer-links">
          <a href={h('why')}>Why Us</a>
          <a href={h('faq')}>FAQ</a>
          <a href="/contact/">Contact</a>
          <a href={`mailto:${contact.email}`}>Email</a>
          <a href={isHome ? '#home' : '#'}>Back to Top</a>
        </div>
      </div>

      <div class="footer-col footer-col-social">
        <div class="footer-heading">Follow</div>
        <SocialIcons class="footer-social" labels />

        <div class="footer-newsletter">
          <span class="footer-newsletter-label">Get the brief</span>
          <span class="footer-newsletter-title">Strategic thinking for businesses moving forward.</span>
          <span class="footer-newsletter-desc">Get monthly insights on business strategy, marketing, technology and transformation.</span>
          <button type="button" class="footer-newsletter-cta" data-brief-open>
            <span>Subscribe to our monthly brief</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Bottom legal bar -->
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span class="copyright">© 2026 Platform Play Venture</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span class="footer-tag">Strategic Growth OS</span>
      </div>
      <div class="footer-bottom-links">
        <a href={contactHref}>Start with Clarity</a>
        <a href={contactHref}>Talk to Our Team</a>
        <a href={isHome ? '#home' : '#'} class="footer-top-link">
          <span>Top</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
        </a>
      </div>
    </div>
  </div>

  <dialog class="ppv-dialog brief-dialog" data-brief-dialog aria-labelledby="brief-title">
    <button type="button" class="ppv-dialog-close" data-dialog-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <form class="lead-form" action="/api/contact" method="POST" novalidate data-lead-form="subscribe">
      <input type="checkbox" name="botcheck" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="form" value="subscribe" />
      <div class="lead-form-body">
        <span class="lead-badge">The PPV Brief</span>
        <h2 class="lead-title" id="brief-title">Subscribe to the brief.</h2>
        <p class="lead-intro">Monthly insights on business strategy, marketing, technology and transformation. No noise, and you can unsubscribe at any time.</p>

        <div class="lead-field">
          <label for="brief-name">Name <span aria-hidden="true">*</span></label>
          <input id="brief-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" placeholder="Your name" />
          <span class="lead-error" data-error-for="name"></span>
        </div>
        <div class="lead-field">
          <label for="brief-email">Work email <span aria-hidden="true">*</span></label>
          <input id="brief-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="name@company.com" />
          <span class="lead-error" data-error-for="email"></span>
        </div>
        <div class="lead-field">
          <label for="brief-company">Company name <span class="lead-optional">(optional)</span></label>
          <input id="brief-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Your organisation" />
        </div>
        <label class="lead-check">
          <input type="checkbox" name="consent" value="yes" required />
          <span>I agree to receive the monthly PPV brief by email.</span>
        </label>
        <span class="lead-error" data-error-for="consent"></span>

        <button type="submit" class="lead-submit">Subscribe to the Brief <span aria-hidden="true">→</span></button>
        <p class="lead-status" data-lead-status role="alert" hidden></p>
      </div>

      <div class="lead-success" data-lead-success hidden tabindex="-1">
        <span class="lead-success-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
        <h2 class="lead-success-title">You're subscribed!</h2>
        <p>Thank you for subscribing to the PPV monthly brief. A confirmation is on its way to your inbox.</p>
        <span class="lead-success-pill">Subscription confirmed</span>
      </div>
    </form>
  </dialog>
</footer>
