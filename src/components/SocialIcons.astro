<div class:list={['social-icons', className]} aria-label="Platform Play Venture on social media">
  {networks.map((n) => (
    <a href={n.url} target="_blank" rel="noopener noreferrer" aria-label={labels ? undefined : n.name}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={n.path} /></svg>
      {labels && <span class="social-icons-label">{n.name}</span>}
    </a>
  ))}
</div>
