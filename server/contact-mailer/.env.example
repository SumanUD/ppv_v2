# Copy to .env on the server (chmod 600). Never commit the real file.
PORT=4130
SMTP_USER=sender@gmail.com
# Gmail app password (spaces are ignored)
SMTP_PASS=xxxx xxxx xxxx xxxx
CONTACT_TO=contact@platformplayventure.com
# Optional, comma-separated: copied on every enquiry
CONTACT_CC=
FROM_NAME=Platform Play Venture
SITE_URL=https://platformplayventure.com
# Optional: where brief subscription requests go (defaults to CONTACT_TO)
BRIEF_TO=
# Optional: phone number shown in emails
CONTACT_PHONE=+91 79808 26489
# Optional: where submissions.jsonl / subscribers.jsonl are written (defaults to ./data)
DATA_DIR=
